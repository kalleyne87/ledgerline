    {
      "parameters": {
        "promptType": "define",
        "text": "=Invoice text:\n{{ ($json.text || '').slice(0, 12000) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You extract data from vendor invoices for a bookkeeping firm. Reply with ONLY a JSON object, no markdown, using exactly these keys: vendor (string), invoice_number (string), invoice_date (YYYY-MM-DD), due_date (YYYY-MM-DD, or empty string if absent), currency (3-letter code), po_number (string, empty if absent), payment_terms (string), subtotal (number), tax (number, 0 if none), total (number), line_items (array of {description, quantity, unit_price, amount}), confidence (\"high\", \"medium\" or \"low\", based on how clearly the document states these values). Copy numbers exactly as printed, even if they look wrong. Never calculate or correct them. Use an empty string or 0 for anything the document does not state. Never guess."
            }
          ]
        }
      },
      "id": "extract-ai",
      "name": "AI Extract Invoice Data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0,
          "maxTokensToSample": 1500
        }
      },
      "id": "claude",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        840,
        520
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Raw invoice text:\n{{ ($('Read PDF Text').first().json.text || '').slice(0, 12000) }}\n\nExtracted data:\n{{ JSON.stringify({ vendor: $json.vendor, invoice_number: $json.invoiceNumber, invoice_date: $json.invoiceDate, due_date: $json.dueDate, po_number: $json.poNumber, payment_terms: $json.terms, subtotal: $json.subtotal, tax: $json.tax, total: $json.total, line_items: $json.lineItems }) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a quality reviewer for an accounts payable team. You are given the raw text of a vendor invoice and the data a previous step extracted from it. Check the extracted data against the raw text. Reply with ONLY a JSON object with these keys: verdict (\"ok\" or \"concern\"), score (integer 0 to 100, how confident you are that the extracted data is accurate and complete), issues (array of short plain-language strings, only real problems such as a value that does not match the text, a suspicious or unusual item, or something that looks altered), changes (array of {field, from, to, reason} for small clean-ups only, where field is one of vendor, po_number or payment_terms, such as fixing capitalization or stray spacing so the vendor name is consistent). Never change amounts, dates or invoice numbers. Do not invent problems. If everything matches, return verdict ok, an empty issues array and an empty changes array."
            }
          ]
        }
      },
      "id": "qc-ai",
      "name": "AI Quality Review",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5-5",
          "mode": "id"
        },
        "options": {
          "temperature": 0,
          "maxTokensToSample": 1200
        }
      },
      "id": "claude-qc",
      "name": "Claude QC",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        1360,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $('Parse and Check').first().json;\nconst raw = String($input.first().json.text ?? '');\nlet q = null;\ntry { q = JSON.parse(raw.replace(/```json|```/g, '').trim()); } catch (e) { q = null; }\nconst out = { ...base, qcScore: null, changes: [] };\nconst reasons = [...(base.reasons || [])];\nif (!q) {\n  reasons.push('The AI quality review could not be completed');\n} else {\n  out.qcScore = Number.isFinite(Number(q.score)) ? Number(q.score) : null;\n  const allowed = { vendor: 'vendor', po_number: 'poNumber', payment_terms: 'terms' };\n  for (const c of (Array.isArray(q.changes) ? q.changes : [])) {\n    const key = allowed[c && c.field];\n    if (key && c.to && String(base[key]) === String(c.from) && String(c.to) !== String(c.from)) {\n      out[key] = String(c.to);\n      out.changes.push({ field: c.field, from: String(c.from), to: String(c.to), reason: String(c.reason || '') });\n    }\n  }\n  if (q.verdict === 'concern') {\n    for (const i of (Array.isArray(q.issues) ? q.issues : [])) reasons.push('AI review: ' + String(i));\n  }\n  if (out.qcScore !== null && out.qcScore < 70) reasons.push('AI quality score is low (' + out.qcScore + ' of 100)');\n}\nout.reasons = reasons;\nout.needsReview = reasons.length > 0;\nout.qcIssues = reasons.filter(r => r.startsWith('AI review:') || r.startsWith('AI quality') || r.startsWith('The AI quality')).map(r => r.replace(/^AI review: /, ''));\nreturn [{ json: out }];"
      },
      "id": "apply-qc",
      "name": "Apply Quality Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst raw = String(input.text ?? '');\nlet d = null;\ntry { d = JSON.parse(raw.replace(/```json|```/g, '').trim()); } catch (e) { d = null; }\nconst submittedBy = String((($('Invoice Upload').first().json.body) || {}).submittedBy || '').slice(0, 80);\nconst reasons = [];\nif (!d) reasons.push('Could not read the invoice details');\nd = d || {};\nconst num = (v) => { const n = Number(String(v ?? '').replace(/[^0-9.\\-]/g, '')); return Number.isFinite(n) && String(v ?? '') !== '' ? n : null; };\nconst items = Array.isArray(d.line_items) ? d.line_items : [];\nconst subtotal = num(d.subtotal);\nconst tax = num(d.tax) ?? 0;\nconst total = num(d.total);\nconst itemsSum = items.reduce((s, i) => s + (num(i.amount) || 0), 0);\nconst money = (n) => (n === null ? '?' : n.toFixed(2));\n\nif (!d.vendor) reasons.push('Missing vendor');\nif (!d.invoice_number) reasons.push('Missing invoice number');\nif (total === null) reasons.push('Missing total');\nif (!d.due_date) reasons.push('Missing due date');\nif (items.length && subtotal !== null && Math.abs(itemsSum - subtotal) > 0.02) {\n  reasons.push(`Line items add up to ${money(itemsSum)} but the subtotal says ${money(subtotal)}`);\n}\nif (subtotal !== null && total !== null && Math.abs(subtotal + tax - total) > 0.02) {\n  reasons.push(`Subtotal plus tax is ${money(subtotal + tax)} but the total says ${money(total)}`);\n}\nif (total !== null && total > 1000) reasons.push('Over the $1,000 auto-approval limit');\nif (total !== null && total > 500 && !d.po_number) reasons.push('No PO number on an invoice over $500');\nif (d.confidence === 'low') reasons.push('The AI marked its own reading as low confidence');\n\nif (d.due_date) {\n  const due = new Date(d.due_date);\n  if (!isNaN(due) && due < new Date(new Date().toDateString())) reasons.push('Already past due');\n}\n\nconst sd = $getWorkflowStaticData('global');\nsd.seen = sd.seen || {};\nif (d.vendor && d.invoice_number) {\n  const key = String(d.vendor).toLowerCase().trim() + '|' + String(d.invoice_number).toLowerCase().trim();\n  if (sd.seen[key]) reasons.push('Possible duplicate: this invoice was already processed');\n  else sd.seen[key] = new Date().toISOString();\n}\n\nconst needsReview = reasons.length > 0;\nreturn [{ json: {\n  submittedBy,\n  vendor: d.vendor || '',\n  invoiceNumber: d.invoice_number || '',\n  invoiceDate: d.invoice_date || '',\n  dueDate: d.due_date || '',\n  currency: d.currency || 'USD',\n  subtotal, tax, total,\n  poNumber: d.po_number || '',\n  terms: d.payment_terms || '',\n  lineItems: items,\n  confidence: d.confidence || '',\n  reasons,\n  needsReview,\n  received: new Date().toISOString(),\n  summary: `${d.vendor || 'Unknown vendor'} invoice ${d.invoice_number || '?'} for ${d.currency || 'USD'} ${money(total)}, due ${d.due_date || 'unknown'}`\n}}];"
      },
      "id": "parse",
      "name": "Parse and Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
