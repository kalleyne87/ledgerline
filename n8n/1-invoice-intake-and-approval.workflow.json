      "typeVersion": 4.5,
      "position": [
        260,
        900
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r['Vendor']);\nconst today = new Date(new Date().toDateString());\nconst soon = rows.filter(r => {\n  const ok = /approved/i.test(String(r['Status'] || ''));\n  const unpaid = !String(r['Paid'] || '').trim();\n  const due = new Date(r['Due Date']);\n  if (!ok || !unpaid || isNaN(due)) return false;\n  const days = Math.round((due - today) / 86400000);\n  return days >= 0 && days <= 3;\n});\nconst text = soon.length\n  ? `:calendar: *Invoices due in the next 3 days*\\n` + soon.map(r => `\u2022 ${r['Vendor']} ${r['Invoice Number']}  ${r['Currency'] || ''} ${r['Total']}  due ${r['Due Date']}`).join('\\n')\n  : ':calendar: *Invoices due in the next 3 days*\\nNothing due soon.';\nreturn [{ json: { text } }];"
      },
      "id": "due-soon",
      "name": "Find Due Soon",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
