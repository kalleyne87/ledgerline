        "text": "={{ `:mag: *Invoice needs review*\n${$('Apply Quality Review').first().json.summary}\n*Why it was flagged*\n${$('Apply Quality Review').first().json.reasons.map(r => '\u2022 ' + r).join('\\n')}\n<${$execution.resumeFormUrl}|Open the review form>` }}",
